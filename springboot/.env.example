# Spring Boot environment / configuration variables for ParlanceChat

SPRING_APPLICATION_NAME=parlance # Spring application name
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/parlancechat # JDBC datasource URL
SPRING_DATASOURCE_USERNAME=postgres # Database username
SPRING_DATASOURCE_PASSWORD=Chir@gMishr@12 # Database password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver # JDBC driver class name
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10 # Hikari connection pool size
SPRING_JPA_HIBERNATE_DDL_AUTO=update # JPA auto DDL behavior
SPRING_JPA_SHOW_SQL=false # Show SQL statements in logs
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect # Hibernate dialect
SPRING_JPA_OPEN_IN_VIEW=false # JPA open-in-view setting
APP_JWT_SECRET=replace-with-a-secure-random-secret # JWT signing secret (must be kept secret)
APP_JWT_ACCESS_EXPIRY=86400000 # Access token expiry in milliseconds
APP_JWT_REFRESH_EXPIRY=604800000 # Refresh token expiry in milliseconds
APP_ADMIN_EMAIL=admin@parlance.com # Default admin email for initial seed user
APP_ADMIN_PASSWORD=Admin1234! # Default admin password for initial seed user
APP_ADMIN_USERNAME=admin # Default admin username for initial seed user
APP_CORS_ORIGINS=http://localhost:3000,https://example.com # Comma-separated allowed CORS origins
SPRING_JACKSON_SERIALIZATION_WRITE_DATES_AS_TIMESTAMPS=false # Jackson date serialization config
SPRING_JACKSON_TIME_ZONE=UTC # Jackson time zone
SPRING_JACKSON_DEFAULT_PROPERTY_INCLUSION=non_null # Jackson property inclusion
SPRING_JACKSON_PROPERTY_NAMING_STRATEGY=SNAKE_CASE # Jackson naming strategy
